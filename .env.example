# Copy to `.env` (which is git-ignored) before running docker compose.
#   cp .env.example .env
# Both vars below have sane defaults in docker-compose.yaml, so .env is optional —
# but setting AIRFLOW_UID avoids file-permission issues on Linux hosts.

# Your host user id, so files the containers write to ./data and ./logs are owned by you.
# Find it with: id -u   (macOS/Linux). On macOS the default 50000 is usually fine.
AIRFLOW_UID=50000

# Extra pip packages installed into the Airflow containers at startup.
_PIP_ADDITIONAL_REQUIREMENTS=requests>=2.31,<3

# -----------------------------
# Champion registry (PostgreSQL)
# -----------------------------
# Used by the training DAG to write the current champion model, and by the serving
# backend to read it.
#
# Example (local):
# CHAMPION_REGISTRY_DATABASE_URL=postgresql://registry:registry@localhost:5432/registry
CHAMPION_REGISTRY_DATABASE_URL=

# -----------------------------
# Serving (FastAPI + Gradio)
# -----------------------------
# Gradio uses this to reach the backend.
BACKEND_URL=http://localhost:8000

# Model selector (optional)
CHAMPION_MODEL_NAME=copd_double_target_system
CHAMPION_MODEL_TARGET=system
